# Free Learning Path Builder Configuration
# Environment mode: development or production
ENV=production
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Optional: Frontend API URL (leave empty for same-domain unified deployment, or set when frontend is deployed separately, e.g. Vercel)
# VITE_API_BASE_URL=https://your-backend-api.onrender.com

# AI Integration: Optional Gemini or OpenAI API Key
# If left empty, system operates seamlessly with its built-in Deterministic AI Engine!
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=deterministic # "gemini", "openai", or "deterministic"

# Calendar Integration: Optional Google Calendar Credentials
# If empty, the system uses the high-fidelity Mock Calendar service with duplicate detection and RFC 5545 .ics export
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Database configuration (defaults to SQLite in backend directory, or PostgreSQL URL)
DATABASE_URL=sqlite:///./learning_paths.db

# Authentication: Google OAuth 2.0 / OpenID Connect
# Get credentials from Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth 2.0 Client ID (Web Application)
# Authorized JavaScript Origins: http://localhost:5173, https://free-learning-path-builder.onrender.com
# Client Secret is kept securely on the server and is never exposed to the frontend.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

